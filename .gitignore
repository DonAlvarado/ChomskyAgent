# 🧠 ChomskyAgent - .gitignore Oficial

# ============================================
# PYTHON / FLASK
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pdb
*.db
*.sqlite3

# Entornos virtuales
venv/
.env
*.env

# Archivos temporales de Flask
instance/
*.pid
*.bak
*.swp

# ============================================
# NODE / NPM / TAILWINDCSS
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Tailwind build output (generated)
app/Front/static/css/output.css
app/Front/static/css/output.css.map

# ============================================
# STATIC GENERATED FILES
# (diagramas, reportes, exportados)
# ============================================
app/Front/static/generated/
app/Front/static/temp/
app/Front/static/uploads/

# archivos generados por diagramadores
*.gv
*.dot
*.xdot
*.svg
*.png
*.jpg

# PDFs generados por el reporte
*.pdf

# ============================================
# IA / MEMORIA / ENTRENAMIENTOS
# ============================================
app/AI/memory.json
app/AI/*.model
app/AI/*.pkl
app/AI/__training__/

# ============================================
# UTILS / CACHE / LOGS
# ============================================
logs/
*.log
*.tmp
*.cache/
.cache/
__temp__/

# ============================================
# TESTING
# ============================================
.pytest_cache/
.tox/
.nox/
htmlcov/
.coverage
test-reports/

# ============================================
# IDEs / SYSTEM TRASH
# ============================================
# VSCode
.vscode/

# JetBrains / PyCharm
.idea/
*.iml

# System files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.Trash-*
*.lnk